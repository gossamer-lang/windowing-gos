// windowing: windows and input for Gossamer programs.
//
// Gets a program from nothing to a window it can render into, and stops
// there: windows, displays, keyboard and text input, pointer, touch, and
// pen, the clipboard, drag and drop, cursors, file dialogs and message
// boxes, and the surfaces a renderer draws to (a software framebuffer, and
// native handles plus helpers for OpenGL, Vulkan, and Metal). It draws
// nothing itself. SDL 3 does the platform work underneath, in the Rust core
// `gos-windowing`; nothing of it shows in this API.
//
//     use std::errors
//     use windowing
//     use windowing::{Event, Key}
//
//     fn run() -> Result<(), errors::Error> {
//         let app = windowing::init("Hello", app_id: "dev.example.hello")?
//         defer app.finalize()
//         let win = app.window(title: "Hello", width: 900, height: 600, resizable: true)?
//         loop {
//             match app.wait()? {
//                 Event::CloseRequested { .. } => break,
//                 Event::KeyDown { key: Key::F, .. } => win.set_fullscreen(!win.is_fullscreen())?,
//                 Event::RedrawRequested { .. } => {
//                     let mut frame = win.framebuffer()?
//                     frame.fill(30, 30, 40)
//                     win.present(frame)?
//                 }
//                 _ => {}
//             }
//         }
//         Ok(())
//     }
//
// Every call that touches a window runs on the main thread; goroutines
// reach the loop through a `Waker` and a channel.

use std::errors
use std::encoding::json
use windowing_app
use windowing_hooks

use crate::support
use crate::{cursor, dialog, display, drag, event, instance, keys, menu, notify, support, surface, system, tray, waker, window, wire}

