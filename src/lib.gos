pub type Capability = capabilities::Capability
pub type Support = capabilities::Support
pub fn capabilities() -> Capabilities { capabilities::capabilities() }

pub type Event = event::Event
pub type Key = keys::Key
pub type Scancode = keys::Scancode
pub type Mods = event::Mods
pub type MouseButton = event::MouseButton
pub type Buttons = event::Buttons
pub type PointerSource = event::PointerSource
pub type PenState = event::PenState
pub type PenAxis = event::PenAxis
pub type Window = window::Window
pub type WindowOptions = window::WindowOptions
pub type WindowId = window::WindowId
pub type WindowKind = window::WindowKind
pub type Graphics = window::Graphics
pub type Attention = window::Attention
pub type Backdrop = window::Backdrop
pub type HitArea = window::HitArea
pub type TextPurpose = window::TextPurpose
pub type Capitalization = window::Capitalization
pub type TextInputOptions = window::TextInputOptions
pub type TextInputCapabilities = window::TextInputCapabilities
pub type Display = display::Display
pub type DisplayId = display::DisplayId
pub type Mode = display::Mode
pub type Rect = display::Rect
pub type Orientation = display::Orientation
pub type Frame = surface::Frame
pub type PixelFormat = surface::PixelFormat
pub type RawHandle = surface::RawHandle
pub type GlContext = surface::GlContext
pub type GlProfile = surface::GlProfile
pub type GlOptions = surface::GlOptions
pub type MetalView = surface::MetalView
pub type Waker = waker::Waker
pub type Theme = system::Theme
pub type Locale = system::Locale
pub type DialogId = dialog::DialogId
pub type DialogChoice = dialog::DialogChoice
