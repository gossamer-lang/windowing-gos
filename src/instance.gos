// One instance per application. Linux serves org.freedesktop.Application;
// Windows and macOS use a per-user lock and acknowledged loopback forwarding.
// macOS native LaunchServices events remain available as OpenRequested.

use std::errors

#[cfg(not(target_os = "linux"))]
use std::os
use crate::support

/// What a later launch asked the running instance to do.
#[derive(Debug, PartialEq, Eq)]
pub enum Request {
    /// Bring the application forward.
    Activate
    /// Open these URIs (`file://` paths or other schemes).
    Open { uris: Vec<String> }
}

/// Context supplied by a desktop launcher. Tokens are single-use and bounded.
#[derive(Debug, Default, PartialEq, Eq)]
pub struct Activation {
    pub token: String
    pub startup_id: String
}
#[derive(Debug, PartialEq, Eq)]
pub struct ForwardedRequest {
    pub request: Request
    pub activation: Activation
}

/// The `file://` URI naming the absolute `path`, each segment percent-encoded.
pub fn file_uri(path: String) -> String { windowing_desktop::file_uri(path) }

/// The local path a `file://` URI names, or `None` for another scheme or host.
pub fn uri_path(uri: String) -> Option<String> { windowing_desktop::uri_path(uri) }

/// The outcome of claiming the application's identity.
pub enum Claim {
    /// This process is the instance; it serves later launches' requests.
    Primary(Listener)
    /// Another process is the instance and has received this launch's request.
    Forwarded
}

/// The primary's request listener. Use wait() without polling on every OS.
/// Linux additionally exposes a readable descriptor for native event loops.
#[derive(Debug, Default, PartialEq, Eq)]
pub struct Listener {
    handle: i64
}

impl Listener {
    /// The requests later launches made since the last call, oldest first.
    pub fn take_requests(&self) -> Vec<Request> {
        match support::ok(windowing_desktop::instance_take_requests(self.handle)) {
            Ok(text) => json::decode::<RequestList>(f"{{\"items\":{text}}}").map(|l| l.items).unwrap_or(#[])
            Err(_) => #[]
        }
    }

    /// Drains requests while preserving the launcher's activation context.
    pub fn take_forwarded(&self) -> Vec<ForwardedRequest> {
        match support::ok(windowing_desktop::instance_take_forwarded(self.handle)) {
            Ok(text) => json::decode::<ForwardedList>(f"{{\"items\":{text}}}").map(|list| list.items).unwrap_or(#[])
            Err(_) => #[]
        }
    }

    /// Waits for forwarded requests without polling. Negative timeout waits indefinitely.
    pub fn wait(&self, timeout_ms: i64) -> Result<bool, errors::Error> {
        support::ok(windowing_desktop::instance_wait(self.handle, timeout_ms))
    }

    /// Gives up the claim; the next launch becomes the instance.
    pub fn close(&self) {
        let _ = support::ok(windowing_desktop::instance_close(self.handle))
    }
}

impl os::fd::Descriptor for Listener {
    fn raw_descriptor(&self) -> i64 {
        support::ok(windowing_desktop::instance_descriptor(self.handle)).unwrap_or(-1)
    }

    fn keep_open(&self) -> Fn() -> () {
        || ()
    }
}

/// Claims `app_id` for this process, or hands `request` to the instance
/// already running and answers `Claim::Forwarded`, after which the process
/// exits. The claim lasts until `Listener::close` or the process ends.
pub fn claim(app_id: String, request: Request) -> Result<Claim, errors::Error> {
    let handle = support::ok(windowing_desktop::instance_claim(app_id, json::encode(request)))?
    if handle == 0 { Ok(Claim::Forwarded) } else { Ok(Claim::Primary(Listener { handle: handle })) }
}

#[cfg(test)]
mod uri_tests {
    use super::{file_uri, uri_path}

    #[test]
    fn a_path_round_trips_through_its_file_uri() {
        let uri = file_uri("/tmp/a b/ü#1.txt")
        assert_eq(uri, "file:///tmp/a%20b/%C3%BC%231.txt")
        assert_eq(uri_path(uri), Some("/tmp/a b/ü#1.txt"))
        assert_eq(uri_path("file://localhost/etc/hosts"), Some("/etc/hosts"))
        assert_eq(uri_path("https://example.com/x"), None)
    }
    #[test]
    fn platform_file_paths_follow_native_rules() { check_platform_paths() }
    #[cfg(not(target_os = "windows"))]
    fn check_platform_paths() { assert_eq(uri_path("file://server/share"), None) }
    #[cfg(target_os = "windows")]
    fn check_platform_paths() {
        assert_eq(uri_path(file_uri("C:\\a b.txt")), Some("C:\\a b.txt"))
        assert_eq(uri_path(file_uri("\\\\server\\share")), Some("\\\\server\\share"))
    }
}

// A list the core encodes, read through a one-field wrapper: typed decoding
// names a concrete struct.
struct RequestList {
    items: Vec<Request>
}

struct ForwardedList { items: Vec<ForwardedRequest> }
